{
  "name": "kshot-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "account_id": "918fa5b4246fc75bf23e1bbd354a3f00",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/download"]
  },
  "routes": [
    { "pattern": "kshot.org", "custom_domain": true },
    { "pattern": "www.kshot.org", "custom_domain": true }
  ],
  "vars": {
    // 上架后填 App Store 链接，例如 https://apps.apple.com/app/id1234567890
    "APP_STORE_URL": ""
  },
  "workers_dev": false
}
